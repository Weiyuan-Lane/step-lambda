aws_region    = "ap-southeast-1"
project_name  = "step-lambda"
environment   = "production"

# Domain you control; MX must point to inbound-smtp.<region>.amazonaws.com for SES inbound
ses_domain    = "alerts.example.com"
ses_recipient = "triage@alerts.example.com"

bedrock_model_id = "anthropic.claude-3-haiku-20240307-v1:0"

# Comma-separated From allowlist; empty = allow all
filter_from_emails = "alerts@example.com,pager@example.com"

# Comma-separated Slack member IDs (U…) / usergroup IDs (S…) / @handles to notify
slack_notify_handles = "U012ABCDEF,S012GHIJKL"

secret_values = {
  JIRA_BASE_URL            = "https://your-org.atlassian.net"
  JIRA_EMAIL               = "bot@example.com"
  JIRA_API_TOKEN           = "replace-me"
  JIRA_PROJECT_KEY         = "OPS"
  JIRA_ASSIGNEE_ACCOUNT_ID = "712020:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
  SLACK_BOT_TOKEN          = "xoxb-replace-me"
  SLACK_CHANNEL            = "#ops-alerts"
}
