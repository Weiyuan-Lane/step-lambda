# Local development – Secrets Manager is only used when ENVIRONMENT=production
# and SECRETS_MANAGER_ARN is set (Terraform sets both on the Lambda).

ENVIRONMENT=development
LOG_LEVEL=INFO

# Leave empty locally; Terraform sets this on the Lambda
# SECRETS_MANAGER_ARN=

# Comma-separated From allowlist; empty = allow all (local default)
FILTER_FROM_EMAILS=alerts@example.com,pager@example.com

# Bedrock (uses Converse outputConfig JSON schema; requires Claude 4.5+)
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MAX_TOKENS=1024

# Jira
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=bot@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=OPS
# Atlassian account ID of the issue assignee
JIRA_ASSIGNEE_ACCOUNT_ID=

# Slack
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
# Comma-separated member IDs (U…), usergroup IDs (S…), or @handles to notify
SLACK_NOTIFY_HANDLES=
