# Local development – Secrets Manager is only used when ENVIRONMENT=production
# and SECRETS_MANAGER_ARN is set (Terraform sets both on the Lambda).

ENVIRONMENT=development
LOG_LEVEL=INFO

# Leave empty locally; Terraform sets this on the Lambda
# SECRETS_MANAGER_ARN=

# Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_CONTEXT_KEY=main
BEDROCK_SYSTEM_PROMPT=You are an incident triage assistant. Summarize clearly and suggest a short action title.
BEDROCK_MAX_TOKENS=1024

# Jira
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=bot@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=OPS
JIRA_ISSUE_TYPE=Task

# Slack (webhook OR bot token + channel)
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# Opsgenie
OPSGENIE_API_KEY=
OPSGENIE_API_URL=https://api.opsgenie.com
OPSGENIE_PRIORITY=P3
